# Copy this file to .env.production on the server and fill secrets.

POSTGRES_USER=binn
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=binn_agent

# Public ports
BINN_HTTP_PORT=80
BINN_DEV_CONSOLE_PORT=5174

# Cloud model provider: deepseek or longcat
BINN_MODEL_PROVIDER=deepseek
BINN_DEEPSEEK_API_KEY=
BINN_DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
BINN_DEEPSEEK_UTILITY_MODEL=deepseek-v4-flash

BINN_LONGCAT_API_KEY=
BINN_LONGCAT_CHAT_MODEL=LongCat-2.0
BINN_LONGCAT_UTILITY_MODEL=LongCat-2.0

# Dev Console is separate from the learner app and token-gated.
BINN_DEBUG_CONSOLE_ENABLED=true
BINN_DEBUG_CONSOLE_TOKEN=replace-with-a-long-random-token
BINN_DEBUG_CONSOLE_ALLOWED_ORIGINS=["http://8.152.198.107:5174"]

# Email verification (required for learner login)
BINN_EMAIL_DELIVERY_MODE=smtp
BINN_EMAIL_VERIFICATION_SECRET=replace-with-a-different-long-random-secret
BINN_SMTP_HOST=smtp.example.com
BINN_SMTP_PORT=587
BINN_SMTP_USERNAME=
BINN_SMTP_PASSWORD=
BINN_SMTP_FROM_ADDRESS=no-reply@example.com
BINN_SMTP_STARTTLS=true
BINN_SMTP_USE_SSL=false

# Optional observability / integrations
BINN_LANGFUSE_ENABLED=false
BINN_FEISHU_MCP_ENABLED=false
BINN_FEISHU_MCP_PORT=8765
BINN_FEISHU_MCP_URL=
BINN_FEISHU_APP_ID=
BINN_FEISHU_APP_SECRET=
BINN_FEISHU_OPENAPI_FALLBACK_ENABLED=true
